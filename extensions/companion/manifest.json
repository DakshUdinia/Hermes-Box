{
  "manifest_version": 3,
  "name": "Hermes Box — Send Tabs to Sandbox",
  "version": "1.0.0",
  "description": "Select open tabs or links in Google Chrome (or any Chromium browser) and launch them inside the isolated Hermes Box disposable sandbox.",
  "permissions": [
    "tabs",
    "contextMenus",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_title": "Hermes Box — Disposable Browser Sandbox",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "key": ""
}
