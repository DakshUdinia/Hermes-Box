{
  "manifest_version": 3,
  "name": "Hermes Box Control Center",
  "version": "1.0.0",
  "description": "In-browser sandbox controller: toggle Urban VPN & uBlock Origin, launch selective multi-tabs, and panic-wipe.",
  "permissions": [
    "management",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_title": "Hermes Box Controls (VPN / Adblock / Panic Wipe)",
    "default_popup": "popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "dashboard.html"
  },
  "key": ""
}
